---
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/utils';
import { SECTION_IDS } from '../utils/visibility';
import type { SectionId } from '../utils/visibility';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const sectionLabels: Record<SectionId, string> = {
  about: t('section.about', lang),
  skills: t('section.skills', lang),
  projects: t('section.projects', lang),
  blog: t('section.blog', lang),
  papers: t('section.papers', lang),
};
---

<!-- Overlay -->
<div id="admin-overlay" class="fixed inset-0 z-40 bg-black/30 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300" aria-hidden="true"></div>

<!-- Drawer -->
<aside
  id="admin-drawer"
  class="fixed top-0 right-0 z-50 h-full w-80 max-w-[90vw]
         bg-[var(--color-bg)] border-l border-[var(--color-border)]
         shadow-2xl translate-x-full transition-transform duration-300 ease-in-out"
  aria-label={t('admin.title', lang)}
>
  <div class="flex flex-col h-full p-6">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <h3 class="text-lg font-semibold text-[var(--color-text)]">
        {t('admin.title', lang)}
      </h3>
      <button
        id="admin-close"
        class="inline-flex items-center justify-center w-8 h-8 rounded-md
               text-[var(--color-text-secondary)] hover:text-[var(--color-text)]
               hover:bg-[var(--color-bg-secondary)] transition-colors duration-200"
        aria-label={t('admin.close', lang)}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Section list -->
    <ul class="flex-1 space-y-2" id="admin-section-list">
      {SECTION_IDS.map((id) => (
        <li>
          <label class="flex items-center gap-3 px-3 py-2.5 rounded-lg
                        hover:bg-[var(--color-bg-secondary)] cursor-pointer
                        transition-colors duration-150">
            <input
              type="checkbox"
              class="admin-checkbox w-4 h-4 rounded border-[var(--color-border)]
                     text-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/30"
              data-section-id={id}
              checked
            />
            <span class="text-sm font-medium text-[var(--color-text)] select-none">
              {sectionLabels[id]}
            </span>
          </label>
        </li>
      ))}
    </ul>

    <!-- Bulk actions -->
    <div class="flex gap-2 pt-4 border-t border-[var(--color-border)]">
      <button
        id="admin-show-all"
        class="flex-1 px-3 py-2 text-sm font-medium rounded-lg
               bg-[var(--color-bg-secondary)] text-[var(--color-text)]
               hover:bg-[var(--color-border)] transition-colors duration-200"
      >
        {t('admin.showAll', lang)}
      </button>
      <button
        id="admin-hide-all"
        class="flex-1 px-3 py-2 text-sm font-medium rounded-lg
               bg-[var(--color-bg-secondary)] text-[var(--color-text)]
               hover:bg-[var(--color-border)] transition-colors duration-200"
      >
        {t('admin.hideAll', lang)}
      </button>
    </div>
  </div>
</aside>

<script>
  (function() {
    var SECTION_IDS = ['about','skills','projects','blog','papers'];
    var STORAGE_KEY = 'section-visibility';

    function getVisibilityMap() {
      try {
        var saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          var parsed = JSON.parse(saved);
          var map = {};
          for (var _i = 0; _i < SECTION_IDS.length; _i++) {
            map[SECTION_IDS[_i]] = parsed[SECTION_IDS[_i]] ?? true;
          }
          return map;
        }
      } catch(e) {}
      var map = {};
      for (var _j = 0; _j < SECTION_IDS.length; _j++) {
        map[SECTION_IDS[_j]] = true;
      }
      return map;
    }

    function setVisibility(id, visible) {
      var map = getVisibilityMap();
      map[id] = visible;
      localStorage.setItem(STORAGE_KEY, JSON.stringify(map));
      window.dispatchEvent(new CustomEvent('visibility-changed', { detail: { id: id, visible: visible } }));
    }

    function showAll() {
      var map = getVisibilityMap();
      for (var _k = 0; _k < SECTION_IDS.length; _k++) {
        map[SECTION_IDS[_k]] = true;
      }
      localStorage.setItem(STORAGE_KEY, JSON.stringify(map));
      window.dispatchEvent(new CustomEvent('visibility-changed', { detail: { all: true } }));
    }

    function hideAll() {
      var map = getVisibilityMap();
      for (var _l = 0; _l < SECTION_IDS.length; _l++) {
        map[SECTION_IDS[_l]] = false;
      }
      localStorage.setItem(STORAGE_KEY, JSON.stringify(map));
      window.dispatchEvent(new CustomEvent('visibility-changed', { detail: { all: true } }));
    }

    var overlay = document.getElementById('admin-overlay');
    var drawer = document.getElementById('admin-drawer');
    var openBtn = document.getElementById('admin-btn');
    var closeBtn = document.getElementById('admin-close');
    var showAllBtn = document.getElementById('admin-show-all');
    var hideAllBtn = document.getElementById('admin-hide-all');
    var checkboxes = drawer.querySelectorAll('.admin-checkbox');

    function open() {
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      drawer.classList.remove('translate-x-full');
      var map = getVisibilityMap();
      checkboxes.forEach(function(cb) {
        cb.checked = map[cb.dataset.sectionId] ?? true;
      });
    }

    function close() {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      drawer.classList.add('translate-x-full');
    }

    openBtn && openBtn.addEventListener('click', open);
    closeBtn && closeBtn.addEventListener('click', close);
    overlay && overlay.addEventListener('click', close);

    checkboxes.forEach(function(cb) {
      cb.addEventListener('change', function() {
        var id = cb.dataset.sectionId;
        if (id) setVisibility(id, cb.checked);
      });
    });

    showAllBtn && showAllBtn.addEventListener('click', function() {
      showAll();
      checkboxes.forEach(function(cb) { cb.checked = true; });
    });

    hideAllBtn && hideAllBtn.addEventListener('click', function() {
      hideAll();
      checkboxes.forEach(function(cb) { cb.checked = false; });
    });

    window.addEventListener('visibility-changed', function(e) {
      if (e.detail && e.detail.all) {
        var map = getVisibilityMap();
        checkboxes.forEach(function(cb) {
          cb.checked = map[cb.dataset.sectionId] ?? true;
        });
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !drawer.classList.contains('translate-x-full')) {
        close();
      }
    });
  })();
</script>
