---
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/utils';
import { SECTION_IDS } from '../utils/visibility';
import type { SectionId } from '../utils/visibility';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const sectionLabels: Record<SectionId, string> = {
  about: t('section.about', lang),
  skills: t('section.skills', lang),
  projects: t('section.projects', lang),
  blog: t('section.blog', lang),
  papers: t('section.papers', lang),
};
---

<!-- Overlay -->
<div id="admin-overlay" class="fixed inset-0 z-40 bg-black/30 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300" aria-hidden="true"></div>

<!-- Drawer -->
<aside
  id="admin-drawer"
  class="fixed top-0 right-0 z-50 h-full w-80 max-w-[90vw]
         bg-[var(--color-bg)] border-l border-[var(--color-border)]
         shadow-2xl translate-x-full transition-transform duration-300 ease-in-out"
  aria-label={t('admin.title', lang)}
>
  <div class="flex flex-col h-full p-6">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <h3 class="text-lg font-semibold text-[var(--color-text)]">
        {t('admin.title', lang)}
      </h3>
      <button
        id="admin-close"
        class="inline-flex items-center justify-center w-8 h-8 rounded-md
               text-[var(--color-text-secondary)] hover:text-[var(--color-text)]
               hover:bg-[var(--color-bg-secondary)] transition-colors duration-200"
        aria-label={t('admin.close', lang)}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Section list -->
    <ul class="flex-1 space-y-2" id="admin-section-list">
      {SECTION_IDS.map((id) => (
        <li>
          <label class="flex items-center gap-3 px-3 py-2.5 rounded-lg
                        hover:bg-[var(--color-bg-secondary)] cursor-pointer
                        transition-colors duration-150">
            <input
              type="checkbox"
              class="admin-checkbox w-4 h-4 rounded border-[var(--color-border)]
                     text-[var(--color-accent)] focus:ring-2 focus:ring-[var(--color-accent)]/30"
              data-section-id={id}
              checked
            />
            <span class="text-sm font-medium text-[var(--color-text)] select-none">
              {sectionLabels[id]}
            </span>
          </label>
        </li>
      ))}
    </ul>

    <!-- Bulk actions -->
    <div class="flex gap-2 pt-4 border-t border-[var(--color-border)]">
      <button
        id="admin-show-all"
        class="flex-1 px-3 py-2 text-sm font-medium rounded-lg
               bg-[var(--color-bg-secondary)] text-[var(--color-text)]
               hover:bg-[var(--color-border)] transition-colors duration-200"
      >
        {t('admin.showAll', lang)}
      </button>
      <button
        id="admin-hide-all"
        class="flex-1 px-3 py-2 text-sm font-medium rounded-lg
               bg-[var(--color-bg-secondary)] text-[var(--color-text)]
               hover:bg-[var(--color-border)] transition-colors duration-200"
      >
        {t('admin.hideAll', lang)}
      </button>
    </div>
  </div>
</aside>

<script>
  import { getVisibilityMap, setVisibility, showAll, hideAll } from '../utils/visibility';

  const overlay = document.getElementById('admin-overlay')!;
  const drawer = document.getElementById('admin-drawer')!;
  const openBtn = document.getElementById('admin-btn');
  const closeBtn = document.getElementById('admin-close');
  const showAllBtn = document.getElementById('admin-show-all');
  const hideAllBtn = document.getElementById('admin-hide-all');
  const checkboxes = drawer.querySelectorAll<HTMLInputElement>('.admin-checkbox');

  function open() {
    overlay.classList.remove('opacity-0', 'pointer-events-none');
    drawer.classList.remove('translate-x-full');
    // Sync checkboxes with current state
    const map = getVisibilityMap();
    checkboxes.forEach((cb) => {
      cb.checked = map[cb.dataset.sectionId as string] ?? true;
    });
  }

  function close() {
    overlay.classList.add('opacity-0', 'pointer-events-none');
    drawer.classList.add('translate-x-full');
  }

  openBtn?.addEventListener('click', open);
  closeBtn?.addEventListener('click', close);
  overlay?.addEventListener('click', close);

  // Toggle individual section
  checkboxes.forEach((cb) => {
    cb.addEventListener('change', () => {
      const id = cb.dataset.sectionId;
      if (id) setVisibility(id as import('../utils/visibility').SectionId, cb.checked);
    });
  });

  showAllBtn?.addEventListener('click', () => {
    showAll();
    checkboxes.forEach((cb) => { cb.checked = true; });
  });

  hideAllBtn?.addEventListener('click', () => {
    hideAll();
    checkboxes.forEach((cb) => { cb.checked = false; });
  });

  // Sync checkboxes when visibility changes externally
  window.addEventListener('visibility-changed', ((e: CustomEvent) => {
    if (e.detail?.all) {
      const map = getVisibilityMap();
      checkboxes.forEach((cb) => {
        cb.checked = map[cb.dataset.sectionId as string] ?? true;
      });
    }
  }) as EventListener);

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !drawer.classList.contains('translate-x-full')) {
      close();
    }
  });
</script>
