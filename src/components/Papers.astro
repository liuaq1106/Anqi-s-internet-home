---
import Section from './Section.astro';
import { t, localized } from '../i18n/utils';
import type { Locale } from '../i18n/utils';
import papers from '../data/papers.json';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<Section id="papers" {lang} title={t('papers.title', lang)}>
  <div class="space-y-4">
    {papers.map((paper) => (
      <div class="group rounded-xl border border-[var(--color-border)]
                  bg-[var(--color-bg-secondary)]/50 hover:bg-[var(--color-bg-secondary)]
                  hover:border-[var(--color-accent)]/20 hover:shadow-sm
                  transition-all duration-300 p-5">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
          <div class="flex-1 min-w-0">
            <!-- Title -->
            <h3 class="text-base font-semibold text-[var(--color-text)]
                       group-hover:text-[var(--color-accent)] transition-colors duration-200">
              {localized(paper.title, lang)}
            </h3>

            <!-- Authors -->
            <p class="text-sm text-[var(--color-text-secondary)] mt-1">
              {localized(paper.authors, lang)}
            </p>

            <!-- Venue + Year -->
            <div class="flex flex-wrap items-center gap-2 mt-2">
              <span class="inline-flex items-center gap-1 text-xs font-medium
                           text-[var(--color-accent)] bg-[var(--color-accent)]/5
                           px-2 py-0.5 rounded-md">
                {localized(paper.venue, lang)}
              </span>
              <span class="text-xs text-[var(--color-text-muted)]">
                {paper.year}
              </span>
            </div>

            {/* Abstract (expandable) */}
            <details class="mt-3 group/details">
              <summary class="text-xs font-medium text-[var(--color-text-muted)]
                              hover:text-[var(--color-text-secondary)] cursor-pointer
                              transition-colors duration-200 select-none">
                Abstract
              </summary>
              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mt-2 pl-2
                        border-l-2 border-[var(--color-border)]">
                {localized(paper.abstract, lang)}
              </p>
            </details>
          </div>

          <!-- Links -->
          <div class="flex sm:flex-col gap-1.5 shrink-0">
            {paper.links.pdf && (
              <a href={paper.links.pdf} target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium
                        border border-[var(--color-border)] text-[var(--color-text-secondary)]
                        hover:text-[var(--color-text)] hover:border-[var(--color-accent)]/30
                        transition-all duration-200">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
                </svg>
                {t('papers.pdf', lang)}
              </a>
            )}
            {paper.links.doi && (
              <a href={paper.links.doi} target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium
                        border border-[var(--color-border)] text-[var(--color-text-secondary)]
                        hover:text-[var(--color-text)] hover:border-[var(--color-accent)]/30
                        transition-all duration-200">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                </svg>
                {t('papers.doi', lang)}
              </a>
            )}
            {paper.links.code && (
              <a href={paper.links.code} target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium
                        border border-[var(--color-border)] text-[var(--color-text-secondary)]
                        hover:text-[var(--color-text)] hover:border-[var(--color-accent)]/30
                        transition-all duration-200">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                </svg>
                Code
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</Section>
