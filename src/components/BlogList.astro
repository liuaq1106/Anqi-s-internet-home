---
import Section from './Section.astro';
import BlogCard from './BlogCard.astro';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/utils';
import { filterPosts, getAllCategories, getAllTags } from '../utils/blog';
import type { Post } from '../utils/blog';

interface Props {
  lang: Locale;
  posts: Post[];
}

const { lang, posts } = Astro.props;
const allCategories = getAllCategories(posts);
const allTags = getAllTags(posts);
---

<Section id="blog" {lang} title={t('blog.title', lang)}>
  <!-- Filters -->
  <div id="blog-filters" class="space-y-4 mb-8" data-lang={lang}>
    <!-- Category filter -->
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold text-[var(--color-text-muted)] mr-1">
        {t('blog.filterByCategory', lang)}:
      </span>
      <button
        class="filter-btn filter-category px-3 py-1.5 rounded-lg text-sm font-medium
               bg-[var(--color-accent)]/10 text-[var(--color-accent)]"
        data-category="all"
      >
        {t('blog.all', lang)}
      </button>
      {allCategories.map((cat) => (
        <button
          class="filter-btn filter-category px-3 py-1.5 rounded-lg text-sm font-medium
                 border border-[var(--color-border)] text-[var(--color-text-secondary)]
                 hover:border-[var(--color-accent)]/30 hover:text-[var(--color-text)]
                 transition-all duration-200"
          data-category={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Tag filter -->
    {allTags.length > 0 && (
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="text-xs font-semibold text-[var(--color-text-muted)] mr-1">
          {t('blog.filterByTag', lang)}:
        </span>
        {allTags.map((tag) => (
          <button
            class="filter-btn filter-tag px-2.5 py-1 rounded-md text-xs font-medium
                   border border-[var(--color-border)] text-[var(--color-text-muted)]
                   hover:border-[var(--color-accent)]/30 hover:text-[var(--color-text)]
                   transition-all duration-200"
            data-tag={tag}
          >
            {tag}
          </button>
        ))}
      </div>
    )}

    <!-- Sort -->
    <div class="flex items-center gap-2">
      <span class="text-xs font-semibold text-[var(--color-text-muted)] mr-1">
        {t('blog.sortByDate', lang)}:
      </span>
      <button
        id="sort-btn"
        class="filter-btn filter-sort inline-flex items-center gap-1 px-3 py-1.5
               rounded-lg text-sm font-medium border border-[var(--color-border)]
               text-[var(--color-text-secondary)]
               hover:border-[var(--color-accent)]/30 hover:text-[var(--color-text)]
               transition-all duration-200"
        data-sort="desc"
      >
        <span id="sort-label">{t('blog.sortNewest', lang)}</span>
        <svg id="sort-icon" width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <polyline points="19 12 12 19 5 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Posts list -->
  <div id="blog-posts" class="space-y-4">
    {filterPosts(posts, { sort: 'desc' }).map((post) => (
      <BlogCard {post} {lang} />
    ))}
  </div>

  <!-- Empty state -->
  <p id="blog-empty" class="hidden text-center text-[var(--color-text-muted)] py-12">
    {t('blog.noPosts', lang)}
  </p>
</Section>

<script>
  import { filterPosts } from '../utils/blog';
  import type { Post } from '../utils/blog';

  // All posts data is embedded in the HTML by Astro at build time.
  // For the filtering to work client-side, we need a reference to all posts.
  // We'll re-query the DOM for card data or use URL params.

  const container = document.getElementById('blog-posts')!;
  const emptyMsg = document.getElementById('blog-empty')!;
  const lang = document.getElementById('blog-filters')!.dataset.lang as 'en' | 'zh';
  const sortBtn = document.getElementById('sort-btn')!;
  const sortLabel = document.getElementById('sort-label')!;
  const sortIcon = document.getElementById('sort-icon')!;

  let currentCategory = 'all';
  let currentTag = '';
  let currentSort = 'desc';

  // Collect all card elements
  const cards = Array.from(container.querySelectorAll<HTMLElement>('a[href]'));

  function updateSortUI() {
    const isAsc = currentSort === 'asc';
    sortLabel.textContent = isAsc ? (lang === 'zh' ? '最早优先' : 'Oldest first') : (lang === 'zh' ? '最新优先' : 'Newest first');
    sortIcon.style.transform = isAsc ? 'rotate(180deg)' : 'rotate(0deg)';
  }

  function applyFilters() {
    let visible = 0;
    cards.forEach((card) => {
      const cardCategory = card.querySelector('[class*="uppercase"]')?.textContent?.trim() || '';
      const tagEls = card.querySelectorAll('span.px-2');
      const cardTags = Array.from(tagEls).map((t) => t.textContent?.trim() || '');
      const dateStr = card.querySelector('time')?.getAttribute('datetime') || '';

      const catMatch = currentCategory === 'all' || cardCategory.toLowerCase() === currentCategory.toLowerCase();
      const tagMatch = !currentTag || cardTags.some((t) => t.toLowerCase() === currentTag.toLowerCase());

      if (catMatch && tagMatch) {
        card.style.display = '';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    // Sort visible cards
    const sortedCards = cards
      .filter((c) => c.style.display !== 'none')
      .sort((a, b) => {
        const da = new Date(a.querySelector('time')?.getAttribute('datetime') || '').getTime();
        const db = new Date(b.querySelector('time')?.getAttribute('datetime') || '').getTime();
        return currentSort === 'asc' ? da - db : db - da;
      });

    // Reorder DOM
    sortedCards.forEach((card) => container.appendChild(card));

    // Empty state
    emptyMsg.classList.toggle('hidden', visible > 0);
  }

  // Category buttons
  document.querySelectorAll('.filter-category').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-category').forEach((b) => {
        b.classList.remove('bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
        b.classList.add('border', 'border-[var(--color-border)]', 'text-[var(--color-text-secondary)]');
      });
      btn.classList.add('bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
      btn.classList.remove('border', 'border-[var(--color-border)]', 'text-[var(--color-text-secondary)]');
      currentCategory = (btn as HTMLElement).dataset.category!;
      applyFilters();
    });
  });

  // Tag buttons
  document.querySelectorAll('.filter-tag').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = (btn as HTMLElement).dataset.tag!;
      if (currentTag === tag) {
        currentTag = '';
        btn.classList.remove('bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
        btn.classList.add('border', 'border-[var(--color-border)]', 'text-[var(--color-text-muted)]');
      } else {
        document.querySelectorAll('.filter-tag').forEach((b) => {
          b.classList.remove('bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
          b.classList.add('border', 'border-[var(--color-border)]', 'text-[var(--color-text-muted)]');
        });
        currentTag = tag;
        btn.classList.add('bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
        btn.classList.remove('border', 'border-[var(--color-border)]', 'text-[var(--color-text-muted)]');
      }
      applyFilters();
    });
  });

  // Sort button
  sortBtn.addEventListener('click', () => {
    currentSort = currentSort === 'desc' ? 'asc' : 'desc';
    sortBtn.dataset.sort = currentSort;
    updateSortUI();
    applyFilters();
  });
</script>
