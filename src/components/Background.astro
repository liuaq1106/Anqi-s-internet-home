---
import Section from './Section.astro';
import Timeline from './Timeline.astro';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/utils';
import background from '../data/background.json';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const presentLabel = t('about.present', lang);
---

<Section id="about" {lang} title={t('about.title', lang)}>
  <div class="grid md:grid-cols-2 gap-16">
    <!-- Education -->
    <div>
      <h3 class="text-sm font-semibold tracking-wider uppercase
                 text-[var(--color-text-muted)] mb-6">
        {t('about.education', lang)}
      </h3>
      <Timeline
        items={background.education.map((e) => ({
          date: e.date,
          title: e.degree,
          subtitle: e.school,
          description: e.description,
        }))}
        {lang}
        {presentLabel}
      />
    </div>

    <!-- Experience -->
    <div>
      <h3 class="text-sm font-semibold tracking-wider uppercase
                 text-[var(--color-text-muted)] mb-6">
        {t('about.experience', lang)}
      </h3>
      <Timeline
        items={background.experience.map((e) => ({
          date: e.date,
          title: e.role,
          subtitle: e.company,
          description: e.description,
        }))}
        {lang}
        {presentLabel}
      />
    </div>
  </div>
</Section>
