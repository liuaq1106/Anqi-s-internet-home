---
import { formatDate } from '../utils/blog';
import { blogPostPath } from '../utils/paths';
import type { Locale } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Locale;
}

const { post, lang } = Astro.props;
const slug = post.id.split('/').pop()?.replace('.md', '') || '';
const href = blogPostPath(lang, slug);
---

<a
  href={href}
  class="block rounded-xl border border-[var(--color-border)]
         bg-[var(--color-bg-secondary)]/50 hover:bg-[var(--color-bg-secondary)]
         hover:border-[var(--color-accent)]/20 hover:shadow-sm
         transition-all duration-300 p-5 group"
>
  <div class="flex items-center gap-2 text-xs text-[var(--color-text-muted)] mb-2">
    <span class="font-medium text-[var(--color-accent)] uppercase tracking-wider">
      {post.data.category}
    </span>
    <span aria-hidden="true">&middot;</span>
    <time datetime={post.data.date.toISOString()}>
      {formatDate(post.data.date, lang)}
    </time>
  </div>

  <h3 class="text-lg font-semibold text-[var(--color-text)]
             group-hover:text-[var(--color-accent)] transition-colors duration-200 mb-1.5">
    {post.data.title}
  </h3>

  <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed line-clamp-2">
    {post.data.description}
  </p>

  {post.data.tags && post.data.tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mt-3">
      {post.data.tags.map((tag: string) => (
        <span class="px-2 py-0.5 rounded-md text-xs font-medium
                     bg-[var(--color-bg-tertiary)] text-[var(--color-text-muted)]">
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
